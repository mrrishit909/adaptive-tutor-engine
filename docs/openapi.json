 "components": {
  "schemas": {
   "AttemptIn": {
    "properties": {
     "learner_id": {
      "type": "string",
      "format": "uuid",
      "title": "Learner Id"
     },
     "item_id": {
      "type": "string",
      "format": "uuid",
      "title": "Item Id"
     },
     "response": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": -1000000.0,
      "title": "Response",
      "description": "Answers are whole numbers; anything else is refused"
     },
     "response_time_ms": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 3600000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Response Time Ms"
     },
     "day": {
      "type": "integer",
      "maximum": 3650.0,
      "minimum": 0.0,
      "title": "Day",
      "description": "Day of the course, for spacing. A real deployment would take this from the clock",
      "default": 0
     }
    },
    "type": "object",
    "required": [
     "learner_id",
     "item_id",
     "response"
    ],
    "title": "AttemptIn"
   },
   "ExperimentIn": {
    "properties": {
     "students": {
      "type": "integer",
      "maximum": 600.0,
      "minimum": 20.0,
      "title": "Students",
      "default": 300
     },
     "days": {
      "type": "integer",
      "maximum": 60.0,
      "minimum": 5.0,
      "title": "Days",
      "default": 30
     }
    },
    "type": "object",
    "title": "ExperimentIn"
   },
   "GenerateIn": {
    "properties": {
     "concept": {
      "type": "string",
      "title": "Concept",
      "description": "Concept key, e.g. int_sub"
     },
     "count": {
      "type": "integer",
      "maximum": 20.0,
      "minimum": 1.0,
      "title": "Count",
      "default": 3
     },
     "seed": {
      "type": "integer",
      "maximum": 1000000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 0
     },
     "target_misconception": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Target Misconception"
     }
    },
    "type": "object",
    "required": [
     "concept"
    ],
    "title": "GenerateIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "NextIn": {
    "properties": {
     "learner_id": {
      "type": "string",
      "format": "uuid",
      "title": "Learner Id"
     },
     "day": {
      "type": "integer",
      "maximum": 3650.0,
      "minimum": 0.0,
      "title": "Day",
      "default": 0
     }
    },
    "type": "object",
    "required": [
     "learner_id"
    ],
    "title": "NextIn"
   },
   "SessionIn": {
    "properties": {
     "activities": {
      "type": "integer",
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Activities",
      "default": 8
     },
     "day": {
      "type": "integer",
      "maximum": 3650.0,
      "minimum": 0.0,
      "title": "Day",
      "default": 0
     },
     "diagnostic": {
      "type": "boolean",
      "title": "Diagnostic",
      "description": "One item per concept in course order instead of the tutor's own choices",
      "default": false
     }
    },
    "type": "object",
    "title": "SessionIn"
   },
   "TutorIn": {
    "properties": {
     "learner_id": {
      "type": "string",
      "format": "uuid",
      "title": "Learner Id"
     },
     "item_id": {
      "type": "string",
      "format": "uuid",
      "title": "Item Id"
     },
     "response": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": -1000000.0,
      "title": "Response"
     },
     "attempt_no": {
      "type": "integer",
      "maximum": 5.0,
      "minimum": 1.0,
      "title": "Attempt No",
      "default": 1
     }
    },
    "type": "object",
    "required": [
     "learner_id",
     "item_id",
     "response"
    ],
    "title": "TutorIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
